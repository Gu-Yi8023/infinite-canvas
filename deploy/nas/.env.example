# Use the actual fnOS data path and LAN address. No credentials belong in this file.
NAS_DATA_DIR=
NAS_LAN_IP=
NAS_HTTPS_PORT=3443
CANVAS_PUBLIC_ORIGIN=

# Optional OpenAI-compatible TTS. Set all three: endpoint, model, secrets/audio.key.
# The endpoint is the complete HTTPS speech URL, including /v1/audio/speech when required.
AUDIO_SPEECH_URL=
AUDIO_MODEL=
AUDIO_USE_PROXY=true
